			isHidden
			summarizeBy: none
			sourceColumn: valido_desde

		column valido_hasta
			dataType: dateTime
			isHidden
			summarizeBy: none
			sourceColumn: valido_hasta

		column es_actual
			dataType: boolean
			summarizeBy: none
			sourceColumn: es_actual

		partition dim_inversor = m
			mode: import
			source =
					let
					    Origen = PostgreSQL.Database(ServidorPostgres, BaseDatos),
					    Tabla = Origen{[Schema="gold",Item="dim_inversor"]}[Data]
					in
					    Tabla

	table dim_tipo_evento

