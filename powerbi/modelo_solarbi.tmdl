createOrReplace

	expression ServidorPostgres = "localhost:30432" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	expression BaseDatos = "solarbi" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	table dim_fecha
		dataCategory: Time

		column sk_fecha
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: sk_fecha

		column fecha
			dataType: dateTime
			isKey
			formatString: dd/mm/yyyy
			summarizeBy: none
			sourceColumn: fecha

		column anio
			dataType: int64
			summarizeBy: none
			sourceColumn: anio

		column trimestre
			dataType: int64
			summarizeBy: none
			sourceColumn: trimestre

		column mes
			dataType: int64
			summarizeBy: none
			sourceColumn: mes

		column mes_nombre
			dataType: string
			summarizeBy: none
			sortByColumn: mes
			sourceColumn: mes_nombre

		column anio_mes
			dataType: string
			summarizeBy: none
			sourceColumn: anio_mes

		column semana_iso
			dataType: int64
			summarizeBy: none
			sourceColumn: semana_iso

		column dia_mes
			dataType: int64
			summarizeBy: none
			sourceColumn: dia_mes

		column dia_semana_num
			dataType: int64
			summarizeBy: none
			sourceColumn: dia_semana_num

		column dia_semana
			dataType: string
			summarizeBy: none
			sortByColumn: dia_semana_num
			sourceColumn: dia_semana

		column es_fin_semana
			dataType: boolean
			summarizeBy: none
			sourceColumn: es_fin_semana

		column estacion
			dataType: string
			summarizeBy: none
			sourceColumn: estacion

		column temporada_lluvia
			dataType: boolean
			summarizeBy: none
			sourceColumn: temporada_lluvia

		column con_telemetria
			dataType: boolean
			summarizeBy: none
			sourceColumn: con_telemetria

		hierarchy 'Calendario'
			level 'Año'
				ordinal: 0
				column: anio
			level 'Trimestre'
				ordinal: 1
				column: trimestre
			level 'Mes'
				ordinal: 2
				column: mes_nombre
			level 'Día'
				ordinal: 3
				column: fecha

		partition dim_fecha = m
			mode: import
			source =
					let
					    Origen = PostgreSQL.Database(ServidorPostgres, BaseDatos),
					    Tabla = Origen{[Schema="gold",Item="dim_fecha"]}[Data]
					in
					    Tabla

	table dim_hora

		column sk_hora
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: sk_hora

		column hora
			dataType: int64
			summarizeBy: none
			sourceColumn: hora

		column etiqueta
			dataType: string
			summarizeBy: none
			sourceColumn: etiqueta

		column franja
			dataType: string
			summarizeBy: none
			sourceColumn: franja

		column periodo_solar
			dataType: string
			summarizeBy: none
			sourceColumn: periodo_solar

		column franja_tarifaria
			dataType: string
			summarizeBy: none
			sourceColumn: franja_tarifaria

		hierarchy 'Día solar'
			level 'Franja'
				ordinal: 0
				column: franja
			level 'Hora'
				ordinal: 1
				column: etiqueta

		partition dim_hora = m
			mode: import
			source =
					let
					    Origen = PostgreSQL.Database(ServidorPostgres, BaseDatos),
					    Tabla = Origen{[Schema="gold",Item="dim_hora"]}[Data]
					in
					    Tabla

