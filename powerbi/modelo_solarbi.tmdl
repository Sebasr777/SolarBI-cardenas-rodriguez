	table fact_contador_diario

		column sk_fecha
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: sk_fecha

		column sk_inversor
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: sk_inversor

		column pv_kwh
			dataType: double
			summarizeBy: none
			sourceColumn: pv_kwh

		column carga_kwh
			dataType: double
			summarizeBy: none
			sourceColumn: carga_kwh

		column carga_desde_red_kwh
			dataType: double
			summarizeBy: none
			sourceColumn: carga_desde_red_kwh

		column bat_carga_kwh
			dataType: double
			summarizeBy: none
			sourceColumn: bat_carga_kwh

		column bat_descarga_kwh
			dataType: double
			summarizeBy: none
			sourceColumn: bat_descarga_kwh

		partition fact_contador_diario = m
			mode: import
			source =
					let
					    Origen = PostgreSQL.Database(ServidorPostgres, BaseDatos),
					    Tabla = Origen{[Schema="gold",Item="fact_contador_diario"]}[Data]
					in
					    Tabla

	table 'Tarifa'

		column 'Tarifa COP por kWh'
			dataType: double
			formatString: #,0
			summarizeBy: none
			sourceColumn: [Value]

		partition 'Tarifa' = calculated
			mode: import
			source = GENERATESERIES ( 500, 1500, 10 )

	table 'Paneles adicionales'

		column 'Paneles adicionales %'
			dataType: double
			formatString: 0%
			summarizeBy: none
			sourceColumn: [Value]

		partition 'Paneles adicionales' = calculated
			mode: import
			source = GENERATESERIES ( 0, 1, 0.05 )

	table Balance

		column Lado
			dataType: string
			summarizeBy: none
			sourceColumn: [Lado]

		column Componente
			dataType: string
			summarizeBy: none
			sortByColumn: Orden
			sourceColumn: [Componente]

		column Orden
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: [Orden]

		partition Balance = calculated
			mode: import
			source = ```
				DATATABLE ( "Lado", STRING, "Componente", STRING, "Orden", INTEGER, {
					{ "1 · De dónde viene", "Sol", 1 }, { "1 · De dónde viene", "Red pública", 2 }, { "1 · De dónde viene", "Batería (descarga)", 3 },
					{ "2 · A dónde va", "Carga (equipos)", 4 }, { "2 · A dónde va", "Batería (carga)", 5 }, { "2 · A dónde va", "Pérdidas de conversión", 6 } } )
				```

	table _Medidas

		measure 'Energía Solar (kWh)' = SUM ( fact_energia_hora[e_solar_kwh] )
			formatString: #,0.0
			displayFolder: 1 Energía

		measure 'Energía a la Carga (kWh)' = SUM ( fact_energia_hora[e_carga_kwh] )
			formatString: #,0.0
			displayFolder: 1 Energía

		measure 'Energía de la Red (kWh)' = SUM ( fact_energia_hora[e_red_kwh] )
			formatString: #,0.0
			displayFolder: 1 Energía

		measure 'Batería Carga (kWh)' = SUM ( fact_energia_hora[e_bat_carga_kwh] )
			formatString: #,0.0
			displayFolder: 1 Energía

		measure 'Batería Descarga (kWh)' = SUM ( fact_energia_hora[e_bat_descarga_kwh] )
			formatString: #,0.0
			displayFolder: 1 Energía

		measure 'Pérdidas de Conversión (kWh)' = MAX ( 0, [Energía Solar (kWh)] + [Energía de la Red (kWh)] + [Batería Descarga (kWh)] - [Energía a la Carga (kWh)] - [Batería Carga (kWh)] )
			formatString: #,0.0
			displayFolder: 1 Energía

		measure 'Autosuficiencia' = 1 - DIVIDE ( MIN ( [Energía de la Red (kWh)], [Energía a la Carga (kWh)] ), [Energía a la Carga (kWh)] )
			formatString: 0.0%
			displayFolder: 2 Balance

		measure 'Fracción Solar' = DIVIDE ( [Energía Solar (kWh)], [Energía Solar (kWh)] + [Energía de la Red (kWh)] )
			formatString: 0.0%
			displayFolder: 2 Balance

		measure 'Dependencia de la Red' = DIVIDE ( [Energía de la Red (kWh)], [Energía Solar (kWh)] + [Energía de la Red (kWh)] )
			formatString: 0.0%
			displayFolder: 2 Balance

		measure 'Eficiencia del Sistema' = DIVIDE ( [Energía a la Carga (kWh)], [Energía Solar (kWh)] + [Energía de la Red (kWh)] )
			formatString: 0.0%
			displayFolder: 2 Balance

		measure 'Balance (kWh)' = ```
				SWITCH ( SELECTEDVALUE ( Balance[Componente] ),
				    "Sol", [Energía Solar (kWh)],
				    "Red pública", [Energía de la Red (kWh)],
				    "Batería (descarga)", [Batería Descarga (kWh)],
				    "Carga (equipos)", [Energía a la Carga (kWh)],
				    "Batería (carga)", [Batería Carga (kWh)],
				    "Pérdidas de conversión", [Pérdidas de Conversión (kWh)] )
				```
			formatString: #,0.0
			displayFolder: 2 Balance

		measure 'Ciclos Equivalentes' = ```
				SUMX ( VALUES ( dim_inversor[cod_inversor] ),
				    DIVIDE ( CALCULATE ( [Batería Descarga (kWh)] ), CALCULATE ( MAX ( dim_inversor[bateria_kwh] ) ) ) )
				```
			formatString: #,0.0
			displayFolder: 3 Batería

		measure 'SoC Promedio' = AVERAGE ( fact_energia_hora[soc_prom_pct] ) / 100
			formatString: 0.0%
			displayFolder: 3 Batería

		measure 'SoC Mínimo' = MIN ( fact_energia_hora[soc_min_pct] ) / 100
			formatString: 0.0%
			displayFolder: 3 Batería

		measure 'Tarifa Seleccionada' = SELECTEDVALUE ( Tarifa[Tarifa COP por kWh], 991.29 )
			formatString: #,0.00
			displayFolder: 4 Economía

		measure 'Ahorro Solar (COP)' = [Energía Solar (kWh)] * [Tarifa Seleccionada]
			formatString: $ #,0
			displayFolder: 4 Economía

		measure 'Costo de la Red (COP)' = [Energía de la Red (kWh)] * [Tarifa Seleccionada]
			formatString: $ #,0
			displayFolder: 4 Economía

		measure 'Paneles Adicionales Seleccionados' = SELECTEDVALUE ( 'Paneles adicionales'[Paneles adicionales %], 0 )
			formatString: 0%
			displayFolder: 4 Economía

		measure 'Energía Solar Escenario (kWh)' = [Energía Solar (kWh)] * ( 1 + [Paneles Adicionales Seleccionados] )
			formatString: #,0.0
			displayFolder: 4 Economía

		measure 'Ahorro Escenario (COP)' = MIN ( [Energía Solar Escenario (kWh)], [Energía a la Carga (kWh)] + [Batería Carga (kWh)] ) * [Tarifa Seleccionada]
			formatString: $ #,0
			displayFolder: 4 Economía

		measure 'Horas Posibles' = CALCULATE ( COUNTROWS ( dim_fecha ), dim_fecha[con_telemetria] = TRUE () ) * 24 * CALCULATE ( DISTINCTCOUNT ( dim_inversor[cod_inversor] ), dim_inversor[cod_inversor] > 0 )
			formatString: #,0
			displayFolder: 5 Calidad de datos

		measure 'Disponibilidad del Registro' = DIVIDE ( SUM ( fact_energia_hora[minutos_con_dato] ) / 60, [Horas Posibles] )
			formatString: 0.0%
			displayFolder: 5 Calidad de datos

		measure '% Datos Válidos' = DIVIDE ( SUM ( fact_energia_hora[lecturas_validas] ), SUM ( fact_energia_hora[lecturas_total] ) )
			formatString: 0.00%
			displayFolder: 5 Calidad de datos

		measure 'Horas con Red Disponible' = SUM ( fact_energia_hora[minutos_red_ok] ) / 60
			formatString: #,0
			displayFolder: 5 Calidad de datos

		measure 'Eventos' = COUNTROWS ( fact_evento )
			formatString: #,0
			displayFolder: 6 Eventos

		measure 'Horas en Evento' = SUM ( fact_evento[duracion_min] ) / 60
			formatString: #,0.0
			displayFolder: 6 Eventos

		measure 'Cortes de Red' = CALCULATE ( [Eventos], dim_tipo_evento[cod_evento] = "RED_NO_DISPONIBLE" )
			formatString: #,0
			displayFolder: 6 Eventos

		measure 'Horas sin Red' = CALCULATE ( [Horas en Evento], dim_tipo_evento[cod_evento] = "RED_NO_DISPONIBLE" )
			formatString: #,0.0
			displayFolder: 6 Eventos

		measure 'Episodios de Batería Baja' = CALCULATE ( [Eventos], dim_tipo_evento[cod_evento] = "SOC_BAJO" )
			formatString: #,0
			displayFolder: 6 Eventos

		measure 'Solar Mes Anterior (kWh)' = CALCULATE ( [Energía Solar (kWh)], DATEADD ( dim_fecha[fecha], -1, MONTH ) )
			formatString: #,0.0
			displayFolder: 7 Inteligencia de tiempo

		measure 'Var Solar vs Mes Anterior' = DIVIDE ( [Energía Solar (kWh)] - [Solar Mes Anterior (kWh)], [Solar Mes Anterior (kWh)] )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: 7 Inteligencia de tiempo

		measure 'Fracción Solar Mes Anterior' = CALCULATE ( [Fracción Solar], DATEADD ( dim_fecha[fecha], -1, MONTH ) )
			formatString: 0.0%
			displayFolder: 7 Inteligencia de tiempo

		measure 'Solar Año Anterior (kWh)' = CALCULATE ( [Energía Solar (kWh)], SAMEPERIODLASTYEAR ( dim_fecha[fecha] ) )
			formatString: #,0.0
			displayFolder: 7 Inteligencia de tiempo

		measure 'Solar Acumulado del Año (kWh)' = TOTALYTD ( [Energía Solar (kWh)], dim_fecha[fecha] )
			formatString: #,0.0
			displayFolder: 7 Inteligencia de tiempo

		measure 'Fracción Solar Móvil 7 Días' = CALCULATE ( [Fracción Solar], DATESINPERIOD ( dim_fecha[fecha], MAX ( dim_fecha[fecha] ), -7, DAY ) )
			formatString: 0.0%
			displayFolder: 7 Inteligencia de tiempo

		measure 'Registros de Contexto' = COUNTROWS ( fact_actividad )
			formatString: #,0
			displayFolder: 8 Actividad

		measure 'Entrenamientos en GPU' = CALCULATE ( [Registros de Contexto], fact_actividad[es_gpu] = TRUE () )
			formatString: #,0
			displayFolder: 8 Actividad

		measure 'Horas de Carga de Cómputo' = CALCULATE ( SUM ( fact_actividad[duracion_min] ) / 60, dim_tipo_contexto[es_carga] = TRUE () )
			formatString: #,0.0
			displayFolder: 8 Actividad

		column Columna
			dataType: int64
			isHidden
			isNameInferred
			summarizeBy: none
			sourceColumn: [Columna]

		partition _Medidas = calculated
			mode: import
			source = ROW ( "Columna", 1 )

