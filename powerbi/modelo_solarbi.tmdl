		hierarchy 'Contexto'
			level 'Categoría'
				ordinal: 0
				column: categoria
			level 'Tipo'
				ordinal: 1
				column: tipo_contexto

		partition dim_tipo_contexto = m
			mode: import
			source =
					let
					    Origen = PostgreSQL.Database(ServidorPostgres, BaseDatos),
					    Tabla = Origen{[Schema="gold",Item="dim_tipo_contexto"]}[Data]
					in
					    Tabla

