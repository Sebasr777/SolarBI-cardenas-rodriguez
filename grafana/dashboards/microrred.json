    {
      "id": 10,
      "title": "Energía de la última hora por fuente (kWh)",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-solarbi"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-solarbi"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Solar' AS fuente, SUM(pv_w) / 60000.0 AS kwh FROM gold.fact_lectura_rt WHERE cod_inversor IN (${inversor:csv}) AND ts > now() - interval '1 hour' UNION ALL SELECT 'Red', SUM(red_w) / 60000.0 FROM gold.fact_lectura_rt WHERE cod_inversor IN (${inversor:csv}) AND ts > now() - interval '1 hour' UNION ALL SELECT 'Batería (descarga)', SUM(GREATEST(bat_w, 0)) / 60000.0 FROM gold.fact_lectura_rt WHERE cod_inversor IN (${inversor:csv}) AND ts > now() - interval '1 hour'"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/kwh/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Fracción solar de la última hora",
      "type": "gauge",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-solarbi"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-solarbi"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT SUM(pv_w) / NULLIF(SUM(pv_w) + SUM(red_w), 0) AS fraccion_solar FROM gold.fact_lectura_rt WHERE cod_inversor IN (${inversor:csv}) AND ts > now() - interval '1 hour'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      }
    }
