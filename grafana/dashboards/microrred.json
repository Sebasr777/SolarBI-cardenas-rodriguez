    {
      "id": 6,
      "title": "Estado actual por inversor",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-solarbi"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-solarbi"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Inversor ' || cod_inversor AS inversor, ts AS ultima_lectura, estado, soc_pct AS soc, pv_w AS solar_w, carga_w, red_w, red_v FROM gold.v_rt_estado_actual WHERE cod_inversor IN (${inversor:csv})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "estado"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Normal": {
                        "color": "green",
                        "index": 0
                      },
                      "Generando": {
                        "color": "#EAB839",
                        "index": 1
                      },
                      "Batería baja": {
                        "color": "red",
                        "index": 2
                      },
                      "Sin red": {
                        "color": "orange",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Balance de potencia: de dónde viene y a dónde va (W)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-solarbi"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-solarbi"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, 'Inv ' || cod_inversor || ' · solar' AS metric, pv_w AS value FROM gold.fact_lectura_rt WHERE cod_inversor IN (${inversor:csv}) AND $__timeFilter(ts) UNION ALL SELECT ts, 'Inv ' || cod_inversor || ' · red', red_w FROM gold.fact_lectura_rt WHERE cod_inversor IN (${inversor:csv}) AND $__timeFilter(ts) UNION ALL SELECT ts, 'Inv ' || cod_inversor || ' · batería', bat_w FROM gold.fact_lectura_rt WHERE cod_inversor IN (${inversor:csv}) AND $__timeFilter(ts) UNION ALL SELECT ts, 'Inv ' || cod_inversor || ' · carga', carga_w FROM gold.fact_lectura_rt WHERE cod_inversor IN (${inversor:csv}) AND $__timeFilter(ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
