# Parámetros NO sensibles → ConfigMap solarbi-config (se inyectan como variables de entorno).
# Cambiar un valor aquí y volver a aplicar no requiere reconstruir ninguna imagen.
PGHOST=postgres
PGPORT=5432
PGDATABASE=solarbi
PGHOST_GRAFANA=postgres
FUENTE_SQLITE=/datos/bronze/opencem-v1.0.0.sqlite
VERIFICAR_SHA=true
UMBRAL_RED_V=180
UMBRAL_SOC_BAJO=15
UMBRAL_SALIDA_V=100
HUECO_SEG=600
UMBRAL_SOC_ALERTA=20
UMBRAL_RED_V_ALERTA=180
DESFASE_DIAS=365
BACKFILL_MIN=180
MODO_FALLA=ninguno
INVERSOR_FALLA=1
